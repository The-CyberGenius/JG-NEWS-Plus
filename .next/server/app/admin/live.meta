{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/admin/layout,_N_T_/admin/live/layout,_N_T_/admin/live/page,_N_T_/admin/live"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/admin/live/__PAGE__",
    "/admin/live",
    "/admin",
    "/_index",
    "/_head"
  ]
}